---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../../layouts/project.astro";
import { getProjectsCollectionName } from "../../../lib/utils/get-projects-collection-name";

export async function getStaticPaths() {
  const projectsEn = await getCollection("projects-en");
  const projectsEs = await getCollection("projects-es");
  return [
    ...projectsEn.map((project) => ({
      params: { lang: "en", slug: project.id },
    })),
    ...projectsEs.map((project) => ({
      params: { lang: "es", slug: project.id },
    })),
  ];
}

const { slug } = Astro.params;
const collection = getProjectsCollectionName(Astro);
const project = await getEntry(collection, slug);
if (!project) {
  return { status: 404 };
}
const { Content } = await render(project);
---

<Layout project={project}>
  <Content />
</Layout>
